{
  "name": "openf1-js",
  "version": "1.0.0",
  "description": "OpenF1 API (https://openf1.org) JavaScript SDK",
  "keywords": [
    "f1",
    "openf1",
    "sdk",
    "api",
    "formula1",
    "typescript",
    "telemetry",
    "motorsport"
  ],
  "homepage": "https://github.com/ianleckey/openf1-js",
  "bugs": {
    "url": "https://github.com/ianleckey/openf1-js/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ianleckey/openf1-js.git"
  },
  "license": "MIT",
  "author": "Ian Leckey <ileckey@proton.me>",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean --target es2022",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "test": "jest",
    "prepublishOnly": "npm run build",
    "release": "standard-version"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "jest": "^30.0.5",
    "nock": "^14.0.7",
    "standard-version": "^9.5.0",
    "ts-jest": "^29.4.0",
    "tsup": "^8.5.1",
    "typescript": "^5.9.2"
  }
}
